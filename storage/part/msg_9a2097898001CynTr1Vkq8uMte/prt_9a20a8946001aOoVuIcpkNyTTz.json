      "content": "---\nimport Layout from '../layouts/Layout.astro';\nimport { categories, getSoftwareByCategory } from '../data/software';\n\nconst categoryData = categories.map(category => ({\n\tname: category,\n\tslug: category.toLowerCase().replace(' ', '-'),\n\tcount: getSoftwareByCategory(category).length\n}));\n---\n\n<Layout title=\"Categories - Open Source Software Alternatives\">\n\t<div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16\">\n\t\t<div class=\"text-center mb-12\">\n\t\t\t<h1 class=\"text-4xl lg:text-5xl font-bold text-secondary-900 mb-6\">\n\t\t\t\tBrowse by Category\n\t\t\t</h1>\n\t\t\t<p class=\"text-xl text-secondary-600 max-w-3xl mx-auto\">\n\t\t\t\tExplore open source alternatives organized by software type and use case. \n\t\t\t\tFind the perfect replacement for your favorite proprietary tools.\n\t\t\t</p>\n\t\t</div>\n\n\t\t<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n\t\t\t{categoryData.map((category) => (\n\t\t\t\t<a \n\t\t\t\t\thref={`/categories/${category.slug}`}\n\t\t\t\t\tclass=\"group bg-white rounded-xl border border-secondary-200 p-8 hover:border-primary-300 hover:shadow-xl transition-all duration-300\"\n\t\t\t\t>\n\t\t\t\t\t<div class=\"flex items-start justify-between mb-4\">\n\t\t\t\t\t\t<div class=\"w-16 h-16 bg-primary-100 rounded-xl flex items-center justify-center group-hover:bg-primary-200 transition-colors\">\n\t\t\t\t\t\t\t<svg class=\"w-8 h-8 text-primary-600\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t\t<path d=\"M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z\"/>\n\t\t\t\t\t\t\t</svg>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<span class=\"inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-secondary-100 text-secondary-800\">\n\t\t\t\t\t\t\t{category.count} alternatives\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t\t<h3 class=\"text-xl font-semibold text-secondary-900 mb-2 group-hover:text-primary-600 transition-colors\">\n\t\t\t\t\t\t{category.name}\n\t\t\t\t\t</h3>\n\t\t\t\t\t\n\t\t\t\t\t<p class=\"text-secondary-600 mb-4\">\n\t\t\t\t\t\tDiscover open source alternatives to popular {category.name.toLowerCase()} software.\n\t\t\t\t\t</p>\n\t\t\t\t\t\n\t\t\t\t\t<div class=\"flex items-center text-primary-600 font-medium group-hover:text-primary-700\">\n\t\t\t\t\t\tExplore category\n\t\t\t\t\t\t<svg class=\"w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n\t\t\t\t\t\t\t<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</div>\n\t\t\t\t</a>\n\t\t\t))}\n\t\t</div>\n\n\t\t<!-- Featured Categories -->\n\t\t<div class=\"mt-20\">\n\t\t\t<h2 class=\"text-3xl font-bold text-secondary-900 mb-8 text-center\">\n\t\t\t\tPopular Categories\n\t\t\t</h2>\n\t\t\t<div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n\t\t\t\t<div class=\"bg-gradient-to-br from-primary-50 to-primary-100 rounded-xl p-8 border border-primary-200\">\n\t\t\t\t\t<h3 class=\"text-2xl font-bold text-primary-900 mb-4\">Graphics & Design</h3>\n\t\t\t\t\t<p class=\"text-primary-700 mb-6\">\n\t\t\t\t\t\tProfessional-grade open source tools for graphic design, image editing, and illustration.\n\t\t\t\t\t</p>\n\t\t\t\t\t<a href=\"/categories/graphics\" class=\"inline-flex items-center text-primary-600 font-semibold hover:text-primary-700\">\n\t\t\t\t\t\tView Graphics Tools\n\t\t\t\t\t\t<svg class=\"w-5 h-5 ml-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n\t\t\t\t\t\t\t<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"bg-gradient-to-br from-secondary-50 to-secondary-100 rounded-xl p-8 border border-secondary-200\">\n\t\t\t\t\t<h3 class=\"text-2xl font-bold text-secondary-900 mb-4\">Productivity</h3>\n\t\t\t\t\t<p class=\"text-secondary-700 mb-6\">\n\t\t\t\t\t\tBoost your productivity with open source alternatives to popular productivity software.\n\t\t\t\t\t</p>\n\t\t\t\t\t<a href=\"/categories/productivity\" class=\"inline-flex items-center text-secondary-600 font-semibold hover:text-secondary-700\">\n\t\t\t\t\t\tView Productivity Tools\n\t\t\t\t\t\t<svg class=\"w-5 h-5 ml-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n\t\t\t\t\t\t\t<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</Layout>"
