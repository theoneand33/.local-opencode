      "content": "---\nimport Layout from '../layouts/Layout.astro';\n---\n\n<Layout title=\"Contribute - Open Source Software Alternatives\">\n\t<div class=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16\">\n\t\t<!-- Hero -->\n\t\t<div class=\"text-center mb-16\">\n\t\t\t<h1 class=\"text-4xl lg:text-5xl font-bold text-secondary-900 mb-6\">\n\t\t\t\tContribute to OpenAlt\n\t\t\t</h1>\n\t\t\t<p class=\"text-xl text-secondary-600 leading-relaxed\">\n\t\t\t\tHelp us build the most comprehensive directory of open source alternatives. \n\t\t\t\tEvery contribution helps someone discover software freedom.\n\t\t\t</p>\n\t\t</div>\n\n\t\t<!-- Ways to Contribute -->\n\t\t<section class=\"mb-16\">\n\t\t\t<h2 class=\"text-3xl font-bold text-secondary-900 mb-8 text-center\">How You Can Help</h2>\n\t\t\t<div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n\t\t\t\t<div class=\"bg-white rounded-xl border border-secondary-200 p-6 hover:shadow-lg transition-shadow\">\n\t\t\t\t\t<div class=\"w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4\">\n\t\t\t\t\t\t<svg class=\"w-6 h-6 text-primary-600\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path d=\"M9 2a1 1 0 000 2h2a1 1 0 100-2H9z\"/>\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\" d=\"M4 5a2 2 0 012-2 1 1 0 000 2H6a2 2 0 100 4h2a2 2 0 100 4h2a1 1 0 100 2 2 2 0 01-2 2H4a2 2 0 01-2-2V7a2 2 0 012-2z\" clip-rule=\"evenodd\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</div>\n\t\t\t\t\t<h3 class=\"text-xl font-semibold text-secondary-900 mb-3\">Suggest Software</h3>\n\t\t\t\t\t<p class=\"text-secondary-600 mb-4\">\n\t\t\t\t\t\tKnow of a great open source alternative that's missing from our directory? Submit it for review.\n\t\t\t\t\t</p>\n\t\t\t\t\t<a href=\"https://github.com\" class=\"text-primary-600 font-medium hover:text-primary-700\">\n\t\t\t\t\t\tSuggest Software →\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"bg-white rounded-xl border border-secondary-200 p-6 hover:shadow-lg transition-shadow\">\n\t\t\t\t\t<div class=\"w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4\">\n\t\t\t\t\t\t<svg class=\"w-6 h-6 text-primary-600\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z\" clip-rule=\"evenodd\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</div>\n\t\t\t\t\t<h3 class=\"text-xl font-semibold text-secondary-900 mb-3\">Improve Information</h3>\n\t\t\t\t\t<p class=\"text-secondary-600 mb-4\">\n\t\t\t\t\t\tHelp us keep software information accurate and up-to-date. Fix descriptions, add tags, or update links.\n\t\t\t\t\t</p>\n\t\t\t\t\t<a href=\"https://github.com\" class=\"text-primary-600 font-medium hover:text-primary-700\">\n\t\t\t\t\t\tUpdate Information →\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"bg-white rounded-xl border border-secondary-200 p-6 hover:shadow-lg transition-shadow\">\n\t\t\t\t\t<div class=\"w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4\">\n\t\t\t\t\t\t<svg class=\"w-6 h-6 text-primary-600\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\" d=\"M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1z\" clip-rule=\"evenodd\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</div>\n\t\t\t\t\t<h3 class=\"text-xl font-semibold text-secondary-900 mb-3\">Write Reviews</h3>\n\t\t\t\t\t<p class=\"text-secondary-600 mb-4\">\n\t\t\t\t\t\tShare your experience with open source software. Help others make informed decisions.\n\t\t\t\t\t</p>\n\t\t\t\t\t<a href=\"https://github.com\" class=\"text-primary-600 font-medium hover:text-primary-700\">\n\t\t\t\t\t\tWrite Review →\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"bg-white rounded-xl border border-secondary-200 p-6 hover:shadow-lg transition-shadow\">\n\t\t\t\t\t<div class=\"w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4\">\n\t\t\t\t\t\t<svg class=\"w-6 h-6 text-primary-600\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path d=\"M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</div>\n\t\t\t\t\t<h3 class=\"text-xl font-semibold text-secondary-900 mb-3\">Spread the Word</h3>\n\t\t\t\t\t<p class=\"text-secondary-600 mb-4\">\n\t\t\t\t\t\tShare OpenAlt with your friends, colleagues, and on social media. Help more people discover open source.\n\t\t\t\t\t</p>\n\t\t\t\t\t<a href=\"https://github.com\" class=\"text-primary-600 font-medium hover:text-primary-700\">\n\t\t\t\t\t\tShare OpenAlt →\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</section>\n\n\t\t<!-- Guidelines -->\n\t\t<section class=\"mb-16\">\n\t\t\t<div class=\"bg-gradient-to-br from-secondary-50 to-secondary-100 rounded-xl p-8 border border-secondary-200\">\n\t\t\t\t<h2 class=\"text-3xl font-bold text-secondary-900 mb-6\">Contribution Guidelines</h2>\n\t\t\t\t<div class=\"space-y-4\">\n\t\t\t\t\t<div class=\"flex items-start space-x-3\">\n\t\t\t\t\t\t<svg class=\"w-6 h-6 text-primary-600 mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clip-rule=\"evenodd\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<h3 class=\"font-semibold text-secondary-900\">Open Source Only</h3>\n\t\t\t\t\t\t\t<p class=\"text-secondary-600\">All software must be open source with OSI-approved licenses.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t\t<div class=\"flex items-start space-x-3\">\n\t\t\t\t\t\t<svg class=\"w-6 h-6 text-primary-600 mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clip-rule=\"evenodd\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<h3 class=\"font-semibold text-secondary-900\">Active Development</h3>\n\t\t\t\t\t\t\t<p class=\"text-secondary-600\">Software should be actively maintained and regularly updated.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t\t<div class=\"flex items-start space-x-3\">\n\t\t\t\t\t\t<svg class=\"w-6 h-6 text-primary-600 mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clip-rule=\"evenodd\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<h3 class=\"font-semibold text-secondary-900\">Accurate Information</h3>\n\t\t\t\t\t\t\t<p class=\"text-secondary-600\">Provide correct, up-to-date information with official links.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\n\t\t\t\t\t<div class=\"flex items-start space-x-3\">\n\t\t\t\t\t\t<svg class=\"w-6 h-6 text-primary-600 mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clip-rule=\"evenodd\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<h3 class=\"font-semibold text-secondary-900\">No Self-Promotion</h3>\n\t\t\t\t\t\t\t<p class=\"text-secondary-600\">Focus on helping users find the best alternatives, not promoting your own projects.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</section>\n\n\t\t<!-- Get Started -->\n\t\t<section class=\"text-center\">\n\t\t\t<h2 class=\"text-3xl font-bold text-secondary-900 mb-6\">Ready to Contribute?</h2>\n\t\t\t<p class=\"text-xl text-secondary-600 mb-8 max-w-2xl mx-auto\">\n\t\t\t\tJoin our community of open source advocates and help make software freedom accessible to everyone.\n\t\t\t</p>\n\t\t\t<div class=\"flex flex-col sm:flex-row gap-4 justify-center\">\n\t\t\t\t<a href=\"https://github.com\" class=\"inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors\">\n\t\t\t\t\tView on GitHub\n\t\t\t\t</a>\n\t\t\t\t<a href=\"/categories\" class=\"inline-flex items-center justify-center px-6 py-3 text-base font-medium text-primary-600 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors border border-primary-200\">\n\t\t\t\t\tBrowse Directory\n\t\t\t\t</a>\n\t\t\t</div>\n\t\t</section>\n\t</div>\n</Layout>"
