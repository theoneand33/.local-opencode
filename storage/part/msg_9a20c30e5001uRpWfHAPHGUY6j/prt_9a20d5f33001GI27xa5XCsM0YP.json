      "content": "---\nimport Layout from '../layouts/Layout.astro';\nimport { softwareData } from '../data/software';\n---\n\n<Layout title=\"About - Open Source Software Alternatives\">\n\t<div class=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16\">\n\t\t<!-- Hero -->\n\t\t<div class=\"text-center mb-16\">\n\t\t\t<h1 class=\"text-4xl lg:text-5xl font-bold text-secondary-900 mb-6\">\n\t\t\t\tAbout OpenAlt\n\t\t\t</h1>\n\t\t\t<p class=\"text-xl text-secondary-600 leading-relaxed\">\n\t\t\t\tWe believe in software freedom, transparency, and community-driven innovation. \n\t\t\t\tOpenAlt is your guide to the best open source alternatives to proprietary software.\n\t\t\t</p>\n\t\t</div>\n\n\t\t<!-- Mission -->\n\t\t<section class=\"mb-16\">\n\t\t\t<div class=\"bg-gradient-to-br from-primary-50 to-primary-100 rounded-xl p-8 border border-primary-200\">\n\t\t\t\t<h2 class=\"text-3xl font-bold text-primary-900 mb-6\">Our Mission</h2>\n\t\t\t\t<p class=\"text-primary-800 text-lg leading-relaxed mb-4\">\n\t\t\t\t\tOpenAlt exists to empower users with knowledge about free and open source software alternatives. \n\t\t\t\t\tWe help people discover powerful, community-driven tools that respect their freedom, privacy, and autonomy.\n\t\t\t\t</p>\n\t\t\t\t<p class=\"text-primary-800 text-lg leading-relaxed\">\n\t\t\t\t\tEvery software recommendation on our platform is carefully vetted to ensure it meets our standards for \n\t\t\t\t\topenness, functionality, and community support.\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</section>\n\n\t\t<!-- Why Open Source -->\n\t\t<section class=\"mb-16\">\n\t\t\t<h2 class=\"text-3xl font-bold text-secondary-900 mb-8 text-center\">Why Choose Open Source?</h2>\n\t\t\t<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t<div class=\"w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4\">\n\t\t\t\t\t\t<svg class=\"w-8 h-8 text-primary-600\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path d=\"M10 12a2 2 0 100-4 2 2 0 000 4z\"/>\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\" d=\"M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z\" clip-rule=\"evenodd\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</div>\n\t\t\t\t\t<h3 class=\"text-xl font-semibold text-secondary-900 mb-3\">Transparency</h3>\n\t\t\t\t\t<p class=\"text-secondary-600\">\n\t\t\t\t\t\tOpen source code is publicly available for anyone to inspect, verify, and improve. No hidden features or surveillance.\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t<div class=\"w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4\">\n\t\t\t\t\t\t<svg class=\"w-8 h-8 text-primary-600\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\" d=\"M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clip-rule=\"evenodd\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</div>\n\t\t\t\t\t<h3 class=\"text-xl font-semibold text-secondary-900 mb-3\">Security</h3>\n\t\t\t\t\t<p class=\"text-secondary-600\">\n\t\t\t\t\t\tWith many eyes on the code, vulnerabilities are quickly found and fixed. You control your data and privacy.\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t<div class=\"w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4\">\n\t\t\t\t\t\t<svg class=\"w-8 h-8 text-primary-600\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path d=\"M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</div>\n\t\t\t\t\t<h3 class=\"text-xl font-semibold text-secondary-900 mb-3\">Community</h3>\n\t\t\t\t\t<p class=\"text-secondary-600\">\n\t\t\t\t\t\tBuilt by communities, for communities. Get support from users worldwide and contribute to software you use.\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t<div class=\"w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4\">\n\t\t\t\t\t\t<svg class=\"w-8 h-8 text-primary-600\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\" d=\"M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z\" clip-rule=\"evenodd\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</div>\n\t\t\t\t\t<h3 class=\"text-xl font-semibold text-secondary-900 mb-3\">Customization</h3>\n\t\t\t\t\t<p class=\"text-secondary-600\">\n\t\t\t\t\t\tModify the software to fit your needs. No vendor lock-in or artificial limitations.\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t<div class=\"w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4\">\n\t\t\t\t\t\t<svg class=\"w-8 h-8 text-primary-600\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path d=\"M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z\"/>\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z\" clip-rule=\"evenodd\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</div>\n\t\t\t\t\t<h3 class=\"text-xl font-semibold text-secondary-900 mb-3\">Free Forever</h3>\n\t\t\t\t\t<p class=\"text-secondary-600\">\n\t\t\t\t\t\tNo subscription fees, licensing costs, or hidden charges. Free to use, modify, and distribute.\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t<div class=\"w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4\">\n\t\t\t\t\t\t<svg class=\"w-8 h-8 text-primary-600\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\" d=\"M2 5a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V5zm3.293 1.293a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 01-1.414-1.414L7.586 10 5.293 7.707a1 1 0 010-1.414zM11 12a1 1 0 100 2h3a1 1 0 100-2h-3z\" clip-rule=\"evenodd\"/>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</div>\n\t\t\t\t\t<h3 class=\"text-xl font-semibold text-secondary-900 mb-3\">Innovation</h3>\n\t\t\t\t\t<p class=\"text-secondary-600\">\n\t\t\t\t\t\tRapid development and innovation driven by global communities. No corporate roadblocks or profit motives.\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</section>\n\n\t\t<!-- Stats -->\n\t\t<section class=\"mb-16\">\n\t\t\t<div class=\"bg-secondary-50 rounded-xl p-8 border border-secondary-200\">\n\t\t\t\t<h2 class=\"text-3xl font-bold text-secondary-900 mb-8 text-center\">Our Impact</h2>\n\t\t\t\t<div class=\"grid grid-cols-2 lg:grid-cols-4 gap-8\">\n\t\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t\t<div class=\"text-3xl font-bold text-primary-600 mb-2\">{softwareData.length}+</div>\n\t\t\t\t\t\t<div class=\"text-secondary-600\">Software Listed</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t\t<div class=\"text-3xl font-bold text-primary-600 mb-2\">13</div>\n\t\t\t\t\t\t<div class=\"text-secondary-600\">Categories</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t\t<div class=\"text-3xl font-bold text-primary-600 mb-2\">100%</div>\n\t\t\t\t\t\t<div class=\"text-secondary-600\">Open Source</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t\t<div class=\"text-3xl font-bold text-primary-600 mb-2\">24/7</div>\n\t\t\t\t\t\t<div class=\"text-secondary-600\">Free Access</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</section>\n\n\t\t<!-- CTA -->\n\t\t<section class=\"text-center\">\n\t\t\t<h2 class=\"text-3xl font-bold text-secondary-900 mb-6\">Join the Movement</h2>\n\t\t\t<p class=\"text-xl text-secondary-600 mb-8 max-w-2xl mx-auto\">\n\t\t\t\tReady to embrace open source? Start exploring alternatives or contribute to our growing database.\n\t\t\t</p>\n\t\t\t<div class=\"flex flex-col sm:flex-row gap-4 justify-center\">\n\t\t\t\t<a href=\"/categories\" class=\"inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors\">\n\t\t\t\t\tBrowse Alternatives\n\t\t\t\t</a>\n\t\t\t\t<a href=\"/contribute\" class=\"inline-flex items-center justify-center px-6 py-3 text-base font-medium text-primary-600 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors border border-primary-200\">\n\t\t\t\t\tContribute\n\t\t\t\t</a>\n\t\t\t</div>\n\t\t</section>\n\t</div>\n</Layout>"
