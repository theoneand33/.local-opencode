\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</section>\n\n\t<!-- Stats Section -->\n\t<section class=\"bg-white py-16 border-b border-secondary-200\">\n\t\t<div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n\t\t\t<div class=\"grid grid-cols-2 lg:grid-cols-4 gap-8\">\n\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t<div class=\"text-3xl font-bold text-primary-600 mb-2\">{softwareData.length}+</div>\n\t\t\t\t\t<div class=\"text-secondary-600\">Software Alternatives</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t<div class=\"text-3xl font-bold text-primary-600 mb-2\">13</div>\n\t\t\t\t\t<div class=\"text-secondary-600\">Categories</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t<div class=\"text-3xl font-bold text-primary-600 mb-2\">100%</div>\n\t\t\t\t\t<div class=\"text-secondary-600\">Open Source</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t<div class=\"text-3xl font-bold text-primary-600 mb-2\">Free</div>\n\t\t\t\t\t<div class=\"text-secondary-600\">Forever</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</section>\n\n\t<!-- Featured Software -->\n\t<section id=\"featured\" class=\"py-20 bg-secondary-50\">\n\t\t<div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n\t\t\t<div class=\"text-center mb-12\">\n\t\t\t\t<h2 class=\"text-3xl lg:text-4xl font-bold text-secondary-900 mb-4\">\n\t\t\t\t\tFeatured Alternatives\n\t\t\t\t</h2>\n\t\t\t\t<p class=\"text-xl text-secondary-600 max-w-2xl mx-auto\">\n\t\t\t\t\tHand-picked open source software that rivals or exceeds their proprietary counterparts.\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n\t\t\t\t{featuredSoftware.slice(0, 6).map((software) => (\n\t\t\t\t\t<SoftwareCard \n\t\t\t\t\t\tname={software.name}\n\t\t\t\t\t\tdescription={software.description}\n\t\t\t\t\t\tcategory={software.category}\n\t\t\t\t\t\tlicense={software.license}\n\t\t\t\t\t\twebsite={software.website}\n\