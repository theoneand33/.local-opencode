      "content": "---\nimport Layout from '../layouts/Layout.astro';\nimport PorscheHeader from '../components/PorscheHeader.vue';\nimport PorscheHero from '../components/PorscheHero.vue';\nimport PorscheServiceCard from '../components/PorscheServiceCard.vue';\n---\n\n<Layout title=\"Porsche Design System Demo - DeGoogle Guide\">\n  <PorscheHeader client:load />\n  <PorscheHero client:load />\n\n  <section class=\"py-12\">\n    <div class=\"container mx-auto\">\n      <p-heading tag=\"h2\" size=\"large\" class=\"mb-8 text-center\">Why De-Google?</p-heading>\n      <div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        <PorscheServiceCard\n          title=\"Privacy Concerns\"\n          description=\"Google tracks your every move across services. De-Googling helps protect your personal data.\"\n          icon=\"🔒\"\n          client:load\n        />\n        <PorscheServiceCard\n          title=\"Data Ownership\"\n          description=\"Take control of your data instead of letting Google monetize it without your consent.\"\n          icon=\"📊\"\n          client:load\n        />\n        <PorscheServiceCard\n          title=\"Digital Freedom\"\n          description=\"Break free from vendor lock-in and choose services that align with your values.\"\n          icon=\"🕊️\"\n          client:load\n        />\n      </div>\n    </div>\n  </section>\n\n  <section class=\"py-12 bg-gray-800\">\n    <div class=\"container mx-auto\">\n      <p-heading tag=\"h2\" size=\"large\" class=\"mb-8 text-center\">Porsche Design System Features</p-heading>\n      <div class=\"grid md:grid-cols-2 gap-8\">\n        <div>\n          <p-heading tag=\"h3\" size=\"medium\" class=\"mb-4\">Consistent Design</p-heading>\n          <p-text>\n            The Porsche Design System provides a comprehensive set of components that ensure\n            consistency across all digital touchpoints while maintaining the brand's premium aesthetic.\n          </p-text>\n        </div>\n        <div>\n          <p-heading tag=\"h3\" size=\"medium\" class=\"mb-4\">Performance Optimized</p-heading>\n          <p-text>\n            Built with performance in mind, the system includes optimized loading strategies,\n            font preloading, and component chunking for the best user experience.\n          </p-text>\n        </div>\n      </div>\n    </div>\n  </section>\n</Layout>"
